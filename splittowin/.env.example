# Copy to .env on the server and fill in. chmod 600. Never commit the real one.

# Provider chain. "claude_code" needs the CLI plus its credentials inside the
# API container; "gemini" needs only a key. Setting a fallback gives two
# independent providers so one having a bad minute is invisible to users.
RECEIPT_PROVIDER=gemini
RECEIPT_FALLBACK_PROVIDER=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_S=45

PROVIDER_MAX_ATTEMPTS=2
PARSE_DEADLINE_S=55

MAX_UPLOAD_BYTES=12582912
MAX_IMAGE_EDGE=1600
RATE_LIMIT_PER_HOUR=60
LOG_LEVEL=INFO

# Same-origin behind Caddy: no cross-origin requests, so no allowlist needed.
CORS_ORIGINS=
