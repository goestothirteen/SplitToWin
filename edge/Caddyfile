# The server's front door. Every site on this box is routed from here.
#
# Caddy obtains and renews Let's Encrypt certificates itself; the certs live
# in the caddy-data volume. Do not delete that volume — every restart would
# then re-issue against Let's Encrypt's rate limit.
{
	email weeingyau@gmail.com
}

fridgeoflove.duckdns.org {
	encode zstd gzip

	header {
		# she's the only audience — stay out of every index
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		-Server
	}

	reverse_proxy fridge:8025
}

split2win.duckdns.org {
	# Access log: who used the app, when, from what device. JSON lines,
	# rotated by Caddy itself, kept a year, on the host in ~/edge/logs/.
	# The API mounts that directory read-only and serves it as /api/stats.
	log {
		output file /var/log/caddy/split2win.log {
			roll_size 10MiB
			roll_keep 12
			roll_keep_for 8760h
			# Caddy's default is 0600, and the API container reads this as
			# uid 1001, not root.
			mode 0644
		}
		# Pay links carry their whole payload in the path (payee's PayNow
		# number, names, amount), so a raw log of URIs would keep all of
		# that for a year. Blank the payload; the open still counts.
		format filter {
			wrap json
			fields {
				request>uri regexp ^/pay/.* /pay/_
			}
		}
	}
	encode zstd gzip

	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}

	# The API and the UI share one hostname, which is what removes CORS from
	# the picture entirely: the browser never makes a cross-origin request.
	handle /api/* {
		# Receipt photos are capped server-side too; this rejects an
		# oversized upload at the edge before it reaches Python.
		request_body {
			max_size 15MB
		}
		uri strip_prefix /api
		reverse_proxy splittowin-api:8000 {
			# A parse can legitimately take ~20s, and retries can push it
			# further. Well clear of that, and under the gunicorn timeout.
			transport http {
				read_timeout 90s
			}
		}
	}

	handle {
		root * /srv/split2win

		# Vite fingerprints these, so they can be cached hard. index.html
		# must not be, or a deploy won't be picked up.
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
